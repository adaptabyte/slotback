# ---------------------------------------------------------------- required
# Public hostname patients and staff use (docker compose builds https://<domain> from it).
SLOTBACK_DOMAIN=waitlist.yourpractice.com
# 32 random bytes, base64. Generate with: npm run cli -- gen-key  (or: openssl rand -base64 32)
# Store it in a secrets manager and back it up separately from the database.
SLOTBACK_ENCRYPTION_KEY=

# ---------------------------------------------------------------- running without docker compose
# SLOTBACK_ENV=production            # production | development | test
# SLOTBACK_PUBLIC_URL=https://waitlist.yourpractice.com
# SLOTBACK_DATABASE=./data/slotback.db
# SLOTBACK_TRUST_PROXY=true          # set when behind a reverse proxy that sets X-Forwarded-For
# PORT=8080

# ---------------------------------------------------------------- security
# SLOTBACK_REQUIRE_MFA=true          # default true in production
# SLOTBACK_SESSION_IDLE_MINUTES=15   # automatic logoff
# SLOTBACK_SESSION_MAX_HOURS=12
# SLOTBACK_RETENTION_DAYS=90         # erase identifiers this long after a patient leaves the waitlist

# ---------------------------------------------------------------- text messages
# SLOTBACK_SMS=twilio                # twilio | webhook | none
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_SERVICE_SID=      # or TWILIO_FROM=+15550001234
# Point your Twilio number's incoming-message webhook at https://<domain>/webhooks/twilio/sms
# so patients can reply YES / NO.

# ---------------------------------------------------------------- email
# SLOTBACK_EMAIL=smtp                # smtp | webhook | none
# SLOTBACK_SMTP_URL=smtps://user:password@smtp.yourprovider.com:465
# SLOTBACK_EMAIL_FROM="Your Practice <waitlist@yourpractice.com>"

# Webhook delivery for texts and/or email through your own messaging platform:
# SLOTBACK_NOTIFY_WEBHOOK_URL=https://...
# SLOTBACK_NOTIFY_WEBHOOK_SECRET=

# ---------------------------------------------------------------- saving bookings
# SLOTBACK_BOOKING=manual            # manual (front-desk task) | webhook | fhir
# SLOTBACK_BOOKING_WEBHOOK_URL=https://your-interface-engine/slotback
# SLOTBACK_BOOKING_WEBHOOK_SECRET=

# ---------------------------------------------------------------- FHIR R4 (openings and/or bookings)
# SLOTBACK_FHIR_BASE_URL=https://fhir.your-ehr.example/api/FHIR/R4
# SLOTBACK_FHIR_TOKEN=               # static bearer token, or client credentials below
# SLOTBACK_FHIR_TOKEN_URL=
# SLOTBACK_FHIR_CLIENT_ID=
# SLOTBACK_FHIR_CLIENT_SECRET=
# SLOTBACK_FHIR_SCOPE=system/Slot.read system/Appointment.write

# ---------------------------------------------------------------- calendar feeds
# SLOTBACK_POLL_SECONDS=120          # how often iCal feeds and FHIR slots are checked
